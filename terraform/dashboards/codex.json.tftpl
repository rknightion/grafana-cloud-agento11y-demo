                        "editorMode": "code",
                        "expr": "(sum(sum_over_time({service_namespace=\"${prefix}\",service_name=\"${svc_agent_host}\"} |= \"dev_session\" | json | event=\"dev_session\" | agent=\"codex\" | __error__=\"\" | unwrap cost_usd | __error__=\"\" [$__range]))) / (sum(count_over_time({service_namespace=\"${prefix}\",service_name=\"${svc_agent_host}\"} |= \"dev_session\" | json | event=\"dev_session\" | agent=\"codex\" | __error__=\"\" [$__range])))",
