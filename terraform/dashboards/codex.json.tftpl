                      "kind": "DataQuery",
                      "group": "loki",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_logs}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "{service_namespace=\"${prefix}\",service_name=\"${svc_agent_host}\"} |= \"dev_session\" | json | event=\"dev_session\" | agent=\"codex\" | __error__=\"\" | label_format level=`{{ if eq .is_error \"true\" }}error{{ else }}info{{ end }}` | label_format detected_level=`{{ if eq .is_error \"true\" }}error{{ else }}info{{ end }}` | drop model | line_format `developer={{.developer}} scenario={{.scenario}} cost_usd={{.cost_usd}} error={{.is_error}} session={{.session_id}}`",
                        "refId": "A",
                        "legendFormat": "",
                        "queryType": "range"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
