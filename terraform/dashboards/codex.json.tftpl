                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${ds_prom}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(max_over_time(gen_ai_client_operation_duration_seconds_count{gen_ai_agent_name=\"codex-${prefix}\",agento11y_tag_service_namespace=\"${prefix}\",gen_ai_operation_name=\"execute_tool\"}[$__range]))",
                        "refId": "A",
                        "legendFormat": "",
                        "range": false,
                        "instant": true
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
