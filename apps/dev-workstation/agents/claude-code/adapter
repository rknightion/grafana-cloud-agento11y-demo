#!/usr/bin/env bash
# Claude-specific installation, gateway login, configuration and single-turn execution.
set -Eeuo pipefail

case "${1:-}" in
  setup)
    : "${CLAUDE_CODE_VERSION:?}" "${GATEWAY_URL:?}"
    claude_bin="$(claude-install "$CLAUDE_CODE_VERSION" "${CLAUDE_CODE_CACHE:-/opt/claude-code}")"
    ln -sf "$claude_bin" "$HOME/.local/bin/claude"
    printf 'claude %s\n' "$(claude --version 2>/dev/null | head -1)" >&2
    ;;
  reseed)
    exec bash "$(dirname "${BASH_SOURCE[0]}")/reseed"
    ;;
  ready)
    force=()
    [[ -e "$AGENT_STATE_DIR/relogin-needed" ]] && force=(--force)
    dev-login "${force[@]}" || exit 1
    rm -f "$AGENT_STATE_DIR/relogin-needed"
    if ! claude plugin list 2>/dev/null | grep -q 'agento11y-claude-code'; then
      claude plugin marketplace add "${AGENTO11Y_MARKETPLACE:?}" >&2 || true
      claude plugin install agento11y-claude-code@agento11y --scope user >&2 || exit 1
    fi
    ;;
  run)
    shift
    text="$1" model="$2" resume_id="$3" budget_remaining="$5"
    effort="$6" MCP="$7" stderr_file="$8"
# Auto-approved tools: what the prompts in PROMPTS_DIR need and no more. No curl, rm, npm or npx
# (fetching goes through the fetch MCP server; the seeded repo is deleted with the session
# directory afterwards). Prompts no longer clone external repositories (they work inside the
# seeded Touchline checkout), so git is read-only plus local checkout/restore/reset; no git
# clone/ls-remote. python3 and node remain for the prompts that write and run small scripts; the
# container's network isolation (agent-host-firewall) is what bounds them. File edits and writes
# are approved only under the session directory (an Edit path rule also governs Write); the
# user-scope config is denied outright, and dev-reseed resets it before every session anyway.
allowed=(
  Read "Edit(./**)" Glob Grep "mcp__$MCP" mcp__time mcp__context7 mcp__deepwiki mcp__fetch mcp__git
  mcp__sequential-thinking mcp__memory
  "Bash(git log:*)" "Bash(git diff:*)" "Bash(git status:*)" "Bash(git show:*)"
  "Bash(git reset:*)" "Bash(git checkout:*)" "Bash(git restore:*)" "Bash(ls:*)" "Bash(cat:*)"
  "Bash(head:*)" "Bash(tail:*)" "Bash(wc:*)" "Bash(grep:*)" "Bash(find:*)" "Bash(sort:*)"
  "Bash(uniq:*)" "Bash(diff:*)" "Bash(mkdir:*)" "Bash(awk:*)" "Bash(cd:*)" "Bash(jq:*)"
  "Bash(python3:*)" "Bash(node:*)"
)
denied=("Edit(~/.claude/**)" "Read(~/.claude/**)")

system_prompt="Work only inside the current repository (already checked out here). Never commit, push, or clone another repository."

resume_flag=()
[[ -n "$resume_id" ]] && resume_flag=(--resume "$resume_id")
set +e
# The shared session runner owns the process group and timeout, including TERM escalation.
result="$(claude -p "$text" --model "$model" --effort "$effort" \
  --max-budget-usd "$budget_remaining" "${resume_flag[@]}" \
  --append-system-prompt "$system_prompt" \
  --allowedTools "${allowed[@]}" --disallowedTools "${denied[@]}" \
  --output-format json 2>"$stderr_file" | tail -n 1)"
rc=$?
set -e
# Error text alone requests reauthentication; an ordinary answer mentioning 401 does not.
error_text="$(jq -r 'select(.is_error == true) | .result // empty' <<<"$result" 2>/dev/null || true)"
if printf '%s\n' "$error_text" | cat "$stderr_file" - \
    | grep -qiE 'gateway sign-in|not logged in|run /login|\b401\b|unauthori[sz]ed|session (has )?expired'; then
  touch "$AGENT_STATE_DIR/relogin-needed"
fi
# Claude restores session costs on resume, so its reported total replaces the running total.
jq -c '. + {cost_mode:"cumulative",total_cost_usd:(.total_cost_usd // 0)}' <<<"$result"
exit "$rc"
    ;;
  *) echo "claude-code adapter: unknown operation" >&2; exit 2 ;;
esac
