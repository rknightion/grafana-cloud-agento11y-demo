#!/usr/bin/env bash
# One developer conversation with shared prompts, budgets and normalized agent results.
set -Eeuo pipefail
runtime_lib="${DEV_RUNTIME_LIB:-/usr/local/lib/dev-workstation/agent-runtime.sh}"
if [[ ! -r "$runtime_lib" ]]; then
  runtime_lib="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/agent-runtime.sh"
fi
# shellcheck source=apps/dev-workstation/lib/agent-runtime.sh
source "$runtime_lib"
# shellcheck source=apps/dev-workstation/lib/session.sh
source "$DEV_RUNTIME_DIR/session.sh"
