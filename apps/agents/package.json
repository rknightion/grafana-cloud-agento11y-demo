{
  "name": "@touchline/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Touchline Times in-app multi-agent service (orchestrator + news, odds, editorial, compliance specialists) on Amazon Bedrock, plus the load generator and the experiment runner.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "start": "node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import ./src/instrumentation.mjs src/server.mjs",
    "loadgen": "AGENT_ROLE=loadgen node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import ./src/instrumentation.mjs src/server.mjs",
    "experiment": "node experiments/run-experiment.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-bedrock-runtime": "3.1173.0",
    "@aws-sdk/credential-provider-node": "3.972.97",
    "@grafana/agento11y": "0.16.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-undici": "0.35.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.5",
    "@touchline/mcp-tools": "file:../mcp-tools",
    "ioredis": "^6.0.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "fast-xml-parser": "5.12.1",
    "@opentelemetry/core": "3.1.1"
  }
}
