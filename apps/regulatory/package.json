{
  "name": "@dossier/regulatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fictional regulatory authoring multi-agent demo",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import ./src/instrumentation.mjs src/server.mjs",
    "loadgen": "AGENT_ROLE=loadgen node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import ./src/instrumentation.mjs src/server.mjs",
    "experiment": "node experiments/run-experiment.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1156.0",
    "@grafana/agento11y": "0.13.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-undici": "0.34.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "fast-xml-parser": "5.11.2",
    "@opentelemetry/core": "2.12.0"
  }
}
